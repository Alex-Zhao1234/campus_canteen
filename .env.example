# 复制为 .env 后按需修改
DATABASE_URL=sqlite+aiosqlite:///../data/canteen.db
SECRET_KEY=change-me-in-production
ALLOWED_EMAIL_DOMAINS=edu.cn
AUTH_ECHO_CODE=true      # 开发模式把验证码回传在接口响应里，生产必须 false
EMBEDDING_BACKEND=none   # none | local | openai  （MVP 阶段先 none）
CORS_ORIGINS=http://localhost:5173
SCHEDULER_ENABLED=true   # 榜单定时任务；跑脚本/测试时可设 false
RANKING_INTERVAL_MINUTES=10
